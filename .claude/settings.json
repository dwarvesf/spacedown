{
  "hooks": {
    "Notification": [],
    "PermissionRequest": [],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" output-offload.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" pre-compact-backup.sh",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" harvest.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" backlog-stage.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" harvest.sh --lab-log",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-lessons.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" context-readiness.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" post-compact-reinject.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" session-state-save.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" citation-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" session-state-save.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-kit-hook.sh\" context-hints.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
