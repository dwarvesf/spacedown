<?xml version="1.0" encoding="UTF-8"?>
<!--
  Containing app: sandboxed, mirroring the safari-web-extension-converter default.
  network.client is REQUIRED here: the app's instructions screen
  is a WKWebView loading a local Main.html, and without network.client a sandboxed
  WKWebView's WebContent process renders a blank window. files.user-selected.read-only
  matches the converter template.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.get-task-allow</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- App Group: the settings store the app writes and the Quick Look extension reads
         (shared/SpacedownSettings.swift, docs/contract-r1.md). Team-prefixed macOS form:
         no provisioning profile entry needed. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>W777S7V8TN.dfoundation.spacedown</string>
    </array>
</dict>
</plist>
