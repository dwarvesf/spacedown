<?xml version="1.0" encoding="UTF-8"?>
<!--
  Containing app, release build: app.entitlements without get-task-allow, which
  notarization rejects. Keep the two files identical otherwise.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- App Group: the settings store the app writes and the Quick Look extension reads
         (shared/SpacedownSettings.swift, docs/contract-r1.md). Team-prefixed macOS form:
         no provisioning profile entry needed. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>W777S7V8TN.dfoundation.spacedown</string>
    </array>
</dict>
</plist>
