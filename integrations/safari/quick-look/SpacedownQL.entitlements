<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!--
	  Read-only home access, so a document's sibling images can be inlined as data:
	  URIs. Quick Look sandbox-extends the previewed FILE only; a relative <img src>
	  next to it is denied (kernel: "deny(1) file-read-data .../fig.png"), which is
	  what made the panel look image-blind. Read-only, home-scoped, and the appex
	  writes nothing and reaches no network.
	-->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/</string>
	</array>
	<!-- App Group: the settings store the app writes and the Quick Look extension reads
	     (shared/SpacedownSettings.swift, docs/contract-r1.md). Team-prefixed macOS form:
	     no provisioning profile entry needed. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>W777S7V8TN.dfoundation.spacedown</string>
	</array>
</dict>
</plist>
