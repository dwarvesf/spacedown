<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the md-preview Safari render helper.
  Launch-on-demand: launchd advertises the Mach service and starts the helper
  only when the sandboxed Safari extension connects; no KeepAlive, no RunAtLoad.
  __HELPER_BIN__ is replaced with the absolute installed path by build-safari.sh.
  ProgramArguments[0] is the real executable (no .sh wrapper), so Background
  Task Management attributes the agent to the helper itself.
  The Label and the Mach service share one name. The service name is baked
  into the extension and helper binaries and the extension's mach-lookup
  entitlement, so all four must change together.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>foundation.d.spacedown.render</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HELPER_BIN__</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>foundation.d.spacedown.render</key>
        <true/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
