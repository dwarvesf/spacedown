#!/usr/bin/env bash
# build-ql-skin: the Quick Look reading skin with the iA Writer fonts embedded.
# The sandboxed Quick Look webview cannot load fonts installed on the Mac, so this
# prepends the @font-face rules from scripts/ia-fontface-css (the four vendored
# iA Writer Quattro V and Mono V files as base64 data URIs), then the readable skin
# source (integrations/safari/quick-look/Resources/ql-reading.css).
#   scripts/build-ql-skin [out.css]      default out: a temp file; prints the path
# build-safari.sh runs this step by itself. Env: IA_FONT_DIR overrides the font dir.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="${_dir}/${_src}"
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
SKIN="${ROOT}/integrations/safari/quick-look/Resources/ql-reading.css"
out="${1:-$(mktemp "${TMPDIR:-/tmp}/ql-ia-skin.XXXXXX")}"

[[ -f "$SKIN" ]] || { echo "build-ql-skin: skin source missing: $SKIN" >&2; exit 2; }

{
  "${ROOT}/scripts/ia-fontface-css"
  cat "$SKIN"
} > "$out"
echo "$out"
