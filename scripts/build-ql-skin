#!/usr/bin/env bash
# build-ql-skin: the Quick Look reading skin with the iA Writer fonts embedded.
# The sandboxed Quick Look webview cannot load fonts installed on the Mac, so this
# prepends @font-face rules that carry the four vendored iA Writer Quattro V and
# Mono V files (assets/fonts/ia/, SIL OFL 1.1) as base64 data URIs, then the
# readable skin source (integrations/safari/quick-look/Resources/ql-reading.css).
#   scripts/build-ql-skin [out.css]      default out: a temp file; prints the path
# build-safari.sh runs this step by itself. Env: IA_FONT_DIR overrides the font dir.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="${_dir}/${_src}"
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
SKIN="${ROOT}/integrations/safari/quick-look/Resources/ql-reading.css"
FONT_DIR="${IA_FONT_DIR:-${ROOT}/assets/fonts/ia}"
out="${1:-$(mktemp "${TMPDIR:-/tmp}/ql-ia-skin.XXXXXX")}"

[[ -f "$SKIN" ]] || { echo "build-ql-skin: skin source missing: $SKIN" >&2; exit 2; }

face() {
  local family=$1 style=$2 file="${FONT_DIR}/$3"
  [[ -f "$file" ]] || { echo "build-ql-skin: font missing: $file" >&2; exit 2; }
  printf '@font-face { font-family: "%s"; font-style: %s; font-weight: 100 900; src: url(data:font/ttf;base64,%s) format("truetype"); }\n' \
    "$family" "$style" "$(base64 < "$file" | tr -d '\n')"
}

{
  echo "/* Generated by scripts/build-ql-skin: iA Writer fonts (SIL OFL 1.1) embedded for the Quick Look sandbox. */"
  face "iA Writer Quattro V" normal iAWriterQuattroV.ttf
  face "iA Writer Quattro V" italic iAWriterQuattroV-Italic.ttf
  face "iA Writer Mono V" normal iAWriterMonoV.ttf
  face "iA Writer Mono V" italic iAWriterMonoV-Italic.ttf
  cat "$SKIN"
} > "$out"
echo "$out"
