# macOS cruft
.DS_Store

# Rendered previews (output goes to /tmp by default; this guards against an
# accidental --out into the repo).
*.html
# ...but these HTML files are source, not rendered output.
!assets/*.html
!integrations/extension/dropzone.html
!integrations/safari/**/dropzone.html
!integrations/safari/**/Main.html

# Build copy of assets/vscode-preview-head.html made by build-safari.sh.
integrations/safari/quick-look/Resources/md-style.html

# Build output (xcodebuild derived data, set-aside Safari appex, render helper).
build/

# Quick Look project generated by xcodegen from project.yml.
integrations/safari/quick-look/*.xcodeproj/

# Finder app bundle compiled by integrations/install.sh.
integrations/finder-app/*.app/

# Xcode editor state.
*.xcuserstate
xcuserdata/

# Python bytecode.
__pycache__/
