#!/usr/bin/env bash
# spacedown-docx: markdown to .docx in the iA Writer look (assets/docx/ia-reference.docx),
# the same look spacedown gives in the browser. The .docx imports into Google Docs with
# its fonts, spacing and margins intact, so it is the default for any doc you share.
#   spacedown-docx <file.md> [-o out.docx]     default out: <file>.docx next to the input
# YAML frontmatter becomes the title block; HTML comments are dropped.
#
# Exit codes: 0 ok | 2 pandoc or reference doc missing | 64 usage | 66 input not found
# stdout: the output path (success only). stderr: diagnostics.
set -euo pipefail

# Resolve this script's own directory, following symlinks (it is linked onto PATH).
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="${_dir}/${_src}"
done
HERE="$(cd -P "$(dirname "$_src")/.." && pwd)"
REF="${HERE}/assets/docx/ia-reference.docx"

usage() { echo "usage: spacedown-docx <file.md> [-o out.docx]" >&2; exit 64; }

src="" out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output) [[ $# -ge 2 ]] || usage; out="$2"; shift 2 ;;
    -h|--help) usage ;;
    -*) echo "spacedown-docx: unknown flag $1" >&2; usage ;;
    *) [[ -z "$src" ]] || usage; src="$1"; shift ;;
  esac
done
[[ -n "$src" ]] || usage
[[ -f "$src" ]] || { echo "spacedown-docx: no such file: $src" >&2; exit 66; }
[[ -f "$REF" ]] || { echo "spacedown-docx: reference doc missing: $REF (run python3 -I scripts/build-docx-reference.py)" >&2; exit 2; }
command -v pandoc >/dev/null || { echo "spacedown-docx: pandoc not found (brew install pandoc)" >&2; exit 2; }
[[ -n "$out" ]] || out="${src%.*}.docx"

pandoc "$src" -f markdown-implicit_figures -t docx --reference-doc "$REF" -o "$out"
echo "$out"
