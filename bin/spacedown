#!/usr/bin/env bash
# spacedown: render markdown (with LaTeX math via KaTeX) to a self-contained
# HTML file and optionally open it in the default browser.
#
# The HTML path runs the Quick Look JavaScript core (marked, KaTeX, highlight.js and the
# plug-ins listed in Resources/load-order.txt) under `osascript -l JavaScript`, through
# assets/sd-cli-render.js. No pandoc and no python for HTML; macOS only.
#
# Exit codes: 0 ok | 1 source bad | 2 render fail (osascript / JS) | 3 entr missing
# | 4 --shot failed | 64 usage | 130 SIGINT
#
# Subcommand: `spacedown docx <file.md> [-o out.docx]` writes a .docx in the iA look
# instead of HTML (pandoc; without it a simpler textutil .docx; exit codes there: 0 ok
# | 2 reference doc or converter missing | 64 usage | 66 input not found).
#
# Subcommand: `spacedown mcp` starts a stdio MCP server (tools render, shot, lint) for coding
# agents; it runs assets/sd-mcp.js under osascript and calls this script for each tool.
#
# stdout: absolute output path (one line, on success only).
# stderr: diagnostics, prefixed with "spacedown:".

set -euo pipefail

VERSION="1.1.0"

# Resolve this script's own directory, following symlinks (it is symlinked onto
# PATH at ~/.local/bin/spacedown). Used to locate the bundled assets/.
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="${_dir}/${_src}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
# Absolute path to this script, used to re-invoke it per-file in folder mode
# (so each file gets the full single-file render path, fonts and all) and per save in --watch.
SELF="${SCRIPT_DIR}/$(basename "$_src")"
# The renderer: a JavaScript for Automation script that loads the Quick Look core and builds
# the page. It reads the page assets next to it, the look as plain files:
#   vscode-preview-head.html    the VSCodium / VS Code Markdown preview look (assets/REFRESH.md)
#   reading-chrome-head/foot    outline sidebar + zoom + copy-source + reading modes
#   skim-surprise.html          optional engine for the "Skim" reading mode
#   ia-theme.css tm-theme.css paper-theme.css   the reading themes; each is one plain .css file
#       so the SAME file also works as a VS Code / VSCodium `markdown.styles` entry
#   cli-base.css                the plain browser page those sheets are written on top of
#   katex/fonts                 the KaTeX fonts, inlined as data: URIs on a page with math
#   fonts/ia                    the iA Writer fonts (SIL OFL), inlined by the ia and paper themes
#   livereload-foot.html        --watch only: a poll script injected into the page
RENDER_JS="${SCRIPT_DIR}/../assets/sd-cli-render.js"
# The Quick Look core: the repo copy in a checkout, the app's own extension when this CLI is
# bundled inside Spacedown.app (Contents/Resources/cli/bin; scripts/bundle-cli).
QL_RES=""
for _c in "${SCRIPT_DIR}/../integrations/safari/quick-look/Resources" \
          "${SCRIPT_DIR}/../../../PlugIns/SpacedownQL.appex/Contents/Resources"; do
  [[ -f "${_c}/load-order.txt" ]] && { QL_RES="$(cd -P "$_c" && pwd)"; break; }
done
# The app's stored settings as JSON ({} when there are none), passed to the core as is.
SD_SETTINGS="${SCRIPT_DIR}/../scripts/sd-settings"
LIVERELOAD_SERVER="${SCRIPT_DIR}/../assets/livereload-server.py"

usage() {
  cat <<'EOF'
spacedown: render markdown (with LaTeX via KaTeX) to HTML; optionally open in browser.

Usage:
  spacedown docx <file> [-o out.docx]
  spacedown <file> [--out PATH] [--no-open] [--watch] [--title STR]
                    [--font-mode ia|tm|paper|read|mono] [--standalone | --no-standalone]
                    [--shot PNG [--shot-width N] [--shot-height N] [--offline]]
                    [--lint-json FILE] [--help] [--version]
  spacedown mcp
  spacedown <dir>  [--out PATH] [--no-open]

Subcommands:
  docx              Markdown to .docx in the iA look (Word and Google Docs).
                    `spacedown docx --help` for its usage. A file literally named
                    "docx" is rendered as `spacedown ./docx`.
  mcp               Start a stdio MCP server (JSON-RPC 2.0 on stdin and stdout) with the
                    tools render, shot and lint, so an agent can see its Markdown before a
                    person reads it. Config: {"mcpServers":{"spacedown":{"command":
                    "spacedown","args":["mcp"]}}}. A file literally named "mcp" is
                    rendered as `spacedown ./mcp`.

Args:
  <file>            Path to a markdown file.
  <dir>             A directory: render every top-level *.md / *.markdown in it
                    and write an index.html linking to each (e.g. `spacedown .`).

Flags:
  --out PATH        Output HTML path. Default: /tmp/spacedown/<slug>.html
  --no-open         Skip browser. Implied when stdout is not a TTY.
  --watch           Re-render on save (requires entr). Ctrl-C to exit.
  --title STR       Title metadata. Default: basename without extension.
  --shot PNG        After rendering, screenshot the output HTML in a private headless
                    Helium, else Chrome or Chromium (fresh profile, your browser is never
                    touched; env BROWSER overrides the binary, as in scripts/layout-check) and write the PNG. Implies --no-open. Prints the PNG path
                    as a second stdout line, and one "WARN wide table" line on stderr
                    per table wider than its container, naming the body cell with the widest unbreakable content (row, column, text). Not with --watch or a <dir>.
  --shot-width N    Screenshot window width in px. Default: 1300.
  --shot-height N   Screenshot window height in px. Default: 1100.
  --offline         With --shot only: the browser resolves no hostnames, so the PNG shows
                    what a reader with no network sees (remote images and fonts missing).
  --lint-json FILE  Also write the Writing X-ray findings (dashes, long sentences, filler
                    words, ticket IDs, with the app's settings applied) to FILE as JSON:
                    {"rules":[...],"sentenceWordLimit":N,"findings":[{"rule","line",
                    "excerpt","message"}]}. line is null when the source line is not found.
                    Not with a <dir>.
  --font-mode MODE  ia (default): iA Writer's Quattro reading look, set in the
                    free iA Writer Quattro and Mono fonts (system fonts when
                    those are not installed). tm: serif reading look ported
                    from thinkingmachines.ai. paper: warm paper theme in the
                    iA Writer fonts. mono: full editor fidelity (mirrored
                    monospace everywhere). read: proportional serif prose for
                    long-form reading, monospace kept for code/tables.
                    Env: SPACEDOWN_FONT_MODE. The other settings the Spacedown app
                    saves (text size, X-ray, ...) apply to the page; its theme does not.

Env:
  SPACEDOWN_THEME_CSS=FILE  a plain CSS theme that replaces the CSS of the active
                    ia, tm or paper mode (same contract as assets/ia-theme.css).
                    read and mono are unaffected.
  SPACEDOWN_EMBED_IMAGES=0  keep image paths as written. By default a local image
                    (relative or absolute path, up to 5 MB) is embedded as a data: URI
                    so the page still shows it when opened on another machine.
  --no-standalone   Write only the body HTML (no head, no page chrome), for embedding.
  --help            Print this.
  --version         Print version + dep status.

Exit codes:
  0  success
  1  source file not found / not readable / empty
  2  the renderer failed (osascript missing or the render script errored)
  3  --watch requested but entr missing
  4  --shot: no Chromium-based browser found, or no screenshot written
  64 usage error
  130 SIGINT (Ctrl-C from --watch)

stdout: absolute output path (success only); with --shot, the PNG path on a second line.
stderr: diagnostics + errors.
EOF
}

log() { echo "spacedown: $*" >&2; }
die() { local code=$1; shift; log "$*"; exit "$code"; }

# The editor's Markdown preview settings file the page mirrors the fonts of (VSCodium, then
# VS Code on macOS; $SPACEDOWN_SETTINGS overrides). Empty when there is none.
vscode_settings_path() {
  local c
  if [[ -n "${SPACEDOWN_SETTINGS:-}" ]]; then
    [[ -f "$SPACEDOWN_SETTINGS" ]] && echo "$SPACEDOWN_SETTINGS"
    return 0
  fi
  for c in \
    "$HOME/Library/Application Support/VSCodium/User/settings.json" \
    "$HOME/Library/Application Support/Code/User/settings.json"; do
    [[ -f "$c" ]] && { echo "$c"; return 0; }
  done
  return 0
}

# One render through the Quick Look core. usage: run_renderer <src> <out> <standalone 0|1> [key=value ...]
# stdout of osascript is dropped; its stderr carries the renderer's diagnostics and any error.
run_renderer() {
  local src="$1" out="$2" standalone="$3" settings
  shift 3
  command -v osascript >/dev/null 2>&1 || { log "osascript not found (the CLI renders on macOS)"; return 2; }
  [[ -n "$QL_RES" ]] || { log "Quick Look core not found (looked for integrations/safari/quick-look/Resources and the app's SpacedownQL.appex)"; return 2; }
  [[ -f "$RENDER_JS" ]] || { log "renderer missing: ${RENDER_JS}"; return 2; }
  settings="$("$SD_SETTINGS" 2>/dev/null || true)"
  [[ "$settings" == "{"* ]] || settings="{}"
  osascript -l JavaScript "$RENDER_JS" \
    "root=${SCRIPT_DIR}/.." "resources=${QL_RES}" "src=${src}" "out=${out}" "standalone=${standalone}" \
    "settings=${settings}" "$@" >/dev/null || return 2
  [[ -s "$out" ]] || return 2
}

print_version() {
  echo "spacedown $VERSION"
  if command -v osascript >/dev/null 2>&1 && [[ -n "$QL_RES" ]]; then
    echo "  renderer: Quick Look core (osascript, no pandoc needed for HTML)"
  else
    echo "  renderer: UNAVAILABLE (needs macOS osascript and the Quick Look core files)"
  fi
  if command -v pandoc >/dev/null 2>&1; then
    echo "  pandoc: $(pandoc --version | head -1) (optional, only for spacedown docx)"
  else
    echo "  pandoc: not installed (optional; spacedown docx falls back to a simpler textutil .docx; brew install pandoc)"
  fi
  if command -v entr >/dev/null 2>&1; then
    echo "  entr: installed (--watch supported)"
  else
    echo "  entr: not installed (--watch unavailable; brew install entr)"
  fi
}

slugify() {
  # lowercase, strip .md extension, non-alphanumeric → -, collapse runs, trim
  local base="${1##*/}"   # basename
  base="${base%.md}"
  base="${base%.markdown}"
  echo "$base" \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# ---- docx subcommand ----
# `spacedown docx <file.md> [-o out.docx]`: markdown to .docx in the iA look, via the
# pandoc reference doc assets/docx/ia-reference.docx. YAML frontmatter becomes the title
# block; HTML comments are dropped. Without pandoc the page is rendered by the Quick Look
# core and converted by textutil: a simpler .docx (no iA styles, math as plain TeX).
# stdout: the output path. Exit: 0 ok | 2 reference doc or converter missing | 64 usage | 66 input not found.
DOCX_REF="${SCRIPT_DIR}/../assets/docx/ia-reference.docx"

docx_usage() {
  cat <<'EOF'
spacedown docx: markdown to .docx in the iA look (imports into Google Docs intact).

Usage:
  spacedown docx <file.md> [-o out.docx]

Flags:
  -o, --output PATH  Output path. Default: <file>.docx next to the input.
  -h, --help         Print this.

Needs pandoc for the iA look. Without it the .docx comes from macOS textutil: simpler
(no iA styles, math as plain TeX), with a note on stderr.

Exit codes: 0 ok | 2 reference doc or converter missing | 64 usage | 66 input not found
stdout: the output path (success only). stderr: diagnostics.
EOF
}

# The no-pandoc .docx: render the body fragment with the Quick Look core, wrap it, textutil it.
docx_textutil() {
  local src="$1" out="$2" work frag title
  command -v textutil >/dev/null 2>&1 || die 2 "docx: neither pandoc nor textutil found (brew install pandoc)"
  work="$(mktemp -d "${TMPDIR:-/tmp}/spacedown-docx.XXXXXX")"
  title="$(basename "$src")"; title="${title%.*}"
  run_renderer "$src" "${work}/frag.html" 0 "absImages=1" "mathAs=tex" || { rm -rf "$work"; die 2 "docx: the renderer failed (see stderr above)"; }
  { printf '<!DOCTYPE html><html><head><meta charset="utf-8"><title>%s</title></head><body>\n' "$title"
    cat "${work}/frag.html"; printf '</body></html>\n'; } > "${work}/doc.html"
  textutil -convert docx -output "$out" "${work}/doc.html" >/dev/null 2>&1 \
    || { rm -rf "$work"; die 2 "docx: textutil failed"; }
  rm -rf "$work"
  log "docx: pandoc not found; wrote a simpler .docx with textutil (no iA styles, math as plain TeX)"
}

docx_main() {
  local src="" out=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output) [[ -n "${2:-}" ]] || { docx_usage >&2; exit 64; }; out="$2"; shift 2 ;;
      --output=*) out="${1#--output=}"; shift ;;
      -h|--help) docx_usage; exit 0 ;;
      -*) log "docx: unknown flag $1"; docx_usage >&2; exit 64 ;;
      *) [[ -z "$src" ]] || { docx_usage >&2; exit 64; }; src="$1"; shift ;;
    esac
  done
  [[ -n "$src" ]] || { docx_usage >&2; exit 64; }
  [[ -f "$src" ]] || die 66 "docx: no such file: $src"
  [[ -n "$out" ]] || out="${src%.*}.docx"
  if ! command -v pandoc >/dev/null; then
    docx_textutil "$src" "$out"
    echo "$out"
    return 0
  fi
  [[ -f "$DOCX_REF" ]] || die 2 "docx: reference doc missing: $DOCX_REF (run python3 -I scripts/build-docx-reference.py)"
  # Same table pre-pass as the HTML path used to have (assets/tables-blankline.py). It reads
  # stdin, so images resolve against the source directory and the working directory, as before.
  local tables="${SCRIPT_DIR}/../assets/tables-blankline.py"
  if command -v python3 >/dev/null 2>&1 && [[ -f "$tables" ]]; then
    python3 "$tables" < "$src" | pandoc -f markdown-implicit_figures -t docx --reference-doc "$DOCX_REF" \
      --resource-path "$(dirname "$src"):." -o "$out"
  else
    pandoc "$src" -f markdown-implicit_figures -t docx --reference-doc "$DOCX_REF" -o "$out"
  fi
  echo "$out"
}

# ---- mcp subcommand ----
# `spacedown mcp`: the MCP server. osascript replaces this process, so stdin and stdout are the
# JSON-RPC channel; nothing else may print to stdout. The server calls $SELF per tool call.
if [[ "${1:-}" == "mcp" ]]; then
  shift
  [[ $# -eq 0 ]] || die 64 "mcp takes no arguments"
  command -v osascript >/dev/null 2>&1 || die 2 "osascript not found (the MCP server runs on macOS)"
  [[ -f "${SCRIPT_DIR}/../assets/sd-mcp.js" ]] || die 2 "MCP server missing: ${SCRIPT_DIR}/../assets/sd-mcp.js"
  exec osascript -l JavaScript "${SCRIPT_DIR}/../assets/sd-mcp.js" "self=${SELF}" "version=${VERSION}"
fi

if [[ "${1:-}" == "docx" ]]; then
  shift
  docx_main "$@"
  exit 0
fi

# ---- parse args ----
FILE=""
OUT=""
NO_OPEN=0
WATCH=0
TITLE=""
STANDALONE=1
SHOT=""
SHOT_W=1300
SHOT_H=1100
OFFLINE=0
LINT_JSON=""
# Body font mode: "ia" (default), "tm" and "paper" = reading themes; "mono" = full editor
# fidelity (mirrored mono everywhere); "read" = proportional serif. Override default via
# $SPACEDOWN_FONT_MODE. It becomes the core's `theme` setting; the app's stored theme is not read.
FONT_MODE="${SPACEDOWN_FONT_MODE:-ia}"
FONT_MODE_RE='^(ia|tm|paper|read|mono)$'
FONT_MODE_MSG="--font-mode must be 'ia', 'tm', 'paper', 'read', or 'mono'"

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 64
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --version|-V) print_version; exit 0 ;;
    --out) [[ -n "${2:-}" ]] || die 64 "--out requires a path"; OUT="$2"; shift 2 ;;
    --out=*) OUT="${1#--out=}"; shift ;;
    --no-open) NO_OPEN=1; shift ;;
    --watch) WATCH=1; shift ;;
    --shot) [[ -n "${2:-}" ]] || die 64 "--shot requires a path"; SHOT="$2"; shift 2 ;;
    --shot=*) SHOT="${1#--shot=}"; shift ;;
    --shot-width) [[ "${2:-}" =~ ^[0-9]+$ ]] || die 64 "--shot-width requires an integer"; SHOT_W="$2"; shift 2 ;;
    --shot-width=*) v="${1#--shot-width=}"; [[ "$v" =~ ^[0-9]+$ ]] || die 64 "--shot-width requires an integer"; SHOT_W="$v"; shift ;;
    --shot-height) [[ "${2:-}" =~ ^[0-9]+$ ]] || die 64 "--shot-height requires an integer"; SHOT_H="$2"; shift 2 ;;
    --shot-height=*) v="${1#--shot-height=}"; [[ "$v" =~ ^[0-9]+$ ]] || die 64 "--shot-height requires an integer"; SHOT_H="$v"; shift ;;
    --offline) OFFLINE=1; shift ;;
    --lint-json) [[ -n "${2:-}" ]] || die 64 "--lint-json requires a path"; LINT_JSON="$2"; shift 2 ;;
    --lint-json=*) LINT_JSON="${1#--lint-json=}"; shift ;;
    --title) [[ -n "${2:-}" ]] || die 64 "--title requires a string"; TITLE="$2"; shift 2 ;;
    --title=*) TITLE="${1#--title=}"; shift ;;
    --font-mode) [[ "${2:-}" =~ $FONT_MODE_RE ]] || die 64 "$FONT_MODE_MSG"; FONT_MODE="$2"; shift 2 ;;
    --font-mode=*) v="${1#--font-mode=}"; [[ "$v" =~ $FONT_MODE_RE ]] || die 64 "$FONT_MODE_MSG"; FONT_MODE="$v"; shift ;;
    --standalone) STANDALONE=1; shift ;;
    --no-standalone) STANDALONE=0; shift ;;
    --) shift; break ;;
    -*) die 64 "unknown flag: $1 (see --help)" ;;
    *)
      if [[ -z "$FILE" ]]; then
        FILE="$1"; shift
      else
        die 64 "unexpected positional arg: $1 (only one file path accepted)"
      fi
      ;;
  esac
done

[[ -n "$FILE" ]] || die 64 "missing required <file> arg (see --help)"
[[ "$OFFLINE" == "0" || -n "$SHOT" ]] || die 64 "--offline only works with --shot (it blocks the network for the screenshot browser)"
if [[ -n "$SHOT" ]]; then
  [[ "$WATCH" == "0" ]] || die 64 "--shot cannot be combined with --watch"
  [[ ! -d "$FILE" ]] || die 64 "--shot needs a single file, not a directory"
  NO_OPEN=1
fi
[[ -z "$LINT_JSON" || ! -d "$FILE" ]] || die 64 "--lint-json needs a single file, not a directory"
# A SPACEDOWN_FONT_MODE typo is caught here too, not silently rendered as no theme.
[[ "$FONT_MODE" =~ $FONT_MODE_RE ]] || die 64 "SPACEDOWN_FONT_MODE: $FONT_MODE_MSG"
if [[ -n "${SPACEDOWN_THEME_CSS:-}" ]]; then
  [[ -f "$SPACEDOWN_THEME_CSS" ]] || die 64 "SPACEDOWN_THEME_CSS not found: $SPACEDOWN_THEME_CSS"
fi

# ---- folder mode ----
# `spacedown <dir>` renders every top-level *.md / *.markdown in <dir> and writes an
# index.html linking to each rendered file. Each per-file render reuses the full
# single-file path by re-invoking this script with --no-open. Top-level only (no recursion).
if [[ -d "$FILE" ]]; then
  dir_abs="$(cd "$FILE" && pwd)"
  dirslug="$(slugify "$(basename "$dir_abs")")"
  [[ -n "$dirslug" ]] || dirslug="folder"
  index_out="${OUT:-/tmp/spacedown/${dirslug}-index.html}"
  mkdir -p "$(dirname "$index_out")"
  index_dir="$(cd "$(dirname "$index_out")" && pwd)"
  index_out="${index_dir}/$(basename "$index_out")"

  # Collect top-level markdown portably (bash 3.2 / BSD find+sort; newlines in names unsupported).
  md_list=()
  while IFS= read -r _f; do [[ -n "$_f" ]] && md_list+=("$_f"); done < <(
    find "$dir_abs" -maxdepth 1 -type f \( -iname '*.md' -o -iname '*.markdown' \) | LC_ALL=C sort
  )
  [[ ${#md_list[@]} -gt 0 ]] || die 1 "no .md / .markdown files in directory: $FILE"

  rows=""
  for _f in "${md_list[@]}"; do
    _base="$(basename "$_f")"
    if _html="$("$SELF" --no-open "$_f" 2>/dev/null)"; then
      if [[ "$(dirname "$_html")" == "$index_dir" ]]; then _href="$(basename "$_html")"; else _href="file://${_html}"; fi
      rows="${rows}    <li><a href=\"${_href}\">${_base}</a></li>"$'\n'
      log "rendered ${_base}"
    else
      rows="${rows}    <li>${_base} <span class=\"fail\">(render failed)</span></li>"$'\n'
      log "FAILED ${_base}"
    fi
  done

  cat > "$index_out" <<HTMLDOC
<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>${dirslug}, markdown index</title>
<style>
  body { font: 15px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; color: #111827; background: #fafafa; max-width: 680px; margin: 40px auto; padding: 0 20px; }
  h1 { font-size: 20px; font-weight: 600; }
  .dir { color: #6b7280; font-size: 13px; font-family: ui-monospace, Menlo, monospace; }
  ul { padding-left: 1.2em; } li { margin: .35em 0; }
  a { color: #4f46e5; text-decoration: none; } a:hover { text-decoration: underline; }
  .fail { color: #b91c1c; font-size: 12px; }
</style></head><body>
<h1>Markdown in <span class="dir">${dir_abs}</span></h1>
<ul>
${rows}</ul>
</body></html>
HTMLDOC
  log "wrote index ${index_out} (${#md_list[@]} files)"
  echo "$index_out"

  [[ -t 1 ]] || NO_OPEN=1
  if [[ "$NO_OPEN" == "0" ]] && command -v open >/dev/null 2>&1; then
    open "$index_out" 2>/dev/null || true
  fi
  exit 0
fi

# ---- validate source ----
[[ -e "$FILE" ]] || die 1 "file not found: $FILE"
[[ -f "$FILE" ]] || die 1 "not a regular file: $FILE"
[[ -r "$FILE" ]] || die 1 "file not readable: $FILE"
[[ -s "$FILE" ]] || die 1 "file is empty: $FILE"

# ---- resolve output path ----
if [[ -z "$OUT" ]]; then
  slug="$(slugify "$FILE")"
  [[ -n "$slug" ]] || die 1 "could not derive slug from filename: $FILE"
  OUT="/tmp/spacedown/${slug}.html"
fi

# Absolutize OUT path (canonical, no relative components).
out_dir="$(cd "$(dirname "$OUT")" 2>/dev/null && pwd || true)"
if [[ -z "$out_dir" ]]; then
  mkdir -p "$(dirname "$OUT")"
  out_dir="$(cd "$(dirname "$OUT")" && pwd)"
fi
OUT="${out_dir}/$(basename "$OUT")"

mkdir -p "$(dirname "$OUT")"

# ---- title ----
if [[ -z "$TITLE" ]]; then
  TITLE="$(basename "$FILE")"
  TITLE="${TITLE%.md}"
  TITLE="${TITLE%.markdown}"
fi

# ---- TTY-detect (Claude-Code-friendly): auto --no-open when stdout is not a tty ----
if [[ ! -t 1 ]]; then
  NO_OPEN=1
fi

# ---- what the renderer is told ----
# Live-reload (watch mode only): a poll script injected into the page + a localhost server.
# Gated on --watch AND python3 AND the assets existing; the default (non-watch) render injects
# nothing and starts no server. Without python3, --watch keeps its entr + manual-refresh
# behavior. The flag is decided before the first render so BOTH it and the entr re-renders
# (SPACEDOWN_LIVERELOAD=1 in the child) carry the poll script.
LIVERELOAD=0
if [[ "${SPACEDOWN_LIVERELOAD:-0}" == "1" ]]; then
  LIVERELOAD=1
elif [[ "$WATCH" == "1" && "$STANDALONE" == "1" ]] \
     && command -v python3 >/dev/null 2>&1 \
     && [[ -f "${SCRIPT_DIR}/../assets/livereload-foot.html" && -f "$LIVERELOAD_SERVER" ]]; then
  LIVERELOAD=1
fi
EMBED_IMAGES=1; [[ "${SPACEDOWN_EMBED_IMAGES:-1}" != "0" ]] || EMBED_IMAGES=0
EMBED_FONTS=1; [[ "${SPACEDOWN_EMBED_FONTS:-1}" != "0" ]] || EMBED_FONTS=0

# ---- the render function (used by both single + watch paths) ----
do_render() {
  local size_in size_out
  size_in="$(wc -c < "$FILE" | tr -d ' ')"
  log "rendering ${FILE} (${size_in} bytes) via the Quick Look core..."
  run_renderer "$FILE" "$OUT" "$STANDALONE" \
    "title=${TITLE}" "fontMode=${FONT_MODE}" "themeOverride=${SPACEDOWN_THEME_CSS:-}" \
    "livereload=${LIVERELOAD}" "embedImages=${EMBED_IMAGES}" "embedFonts=${EMBED_FONTS}" \
    "vscodeSettings=$(vscode_settings_path)" ${LINT_JSON:+"lintOut=${LINT_JSON}"} || return 2
  size_out="$(wc -c < "$OUT" | tr -d ' ')"
  log "wrote ${OUT} (${size_out} bytes)"
}

# ---- screenshot (--shot) ----
# Find the screenshot browser the way scripts/layout-check does: $BROWSER if set, else the
# Helium binary, then Chrome and Chromium (macOS app paths, then PATH). Never Edge: it grabs
# the screen on the owner's Mac. Every launch gets a fresh profile (see run_shot_browser).
find_shot_browser() {
  local c
  for c in \
    "${BROWSER:-}" \
    "/Applications/Helium.app/Contents/MacOS/Helium" \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium"; do
    [[ -n "$c" && -x "$c" ]] && { echo "$c"; return 0; }
  done
  for c in google-chrome chromium chromium-browser; do
    command -v "$c" 2>/dev/null && return 0
  done
  return 1
}

# Run the browser headless in a fresh profile and wait for its output file; new headless
# may never exit after --screenshot or --dump-dom, so poll up to 30s, then kill it.
# usage: run_shot_browser <bin> <png|dom> <outfile> <url>
run_shot_browser() {
  local bin="$1" kind="$2" outfile="$3" url="$4" profile pid i ready=0
  profile="$(mktemp -d "${TMPDIR:-/tmp}/spacedown-shot.XXXXXX")"
  local args=( --headless=new "--user-data-dir=${profile}" --disable-gpu --hide-scrollbars
               "--window-size=${SHOT_W},${SHOT_H}" --virtual-time-budget=5000 )
  [[ "$OFFLINE" == "0" ]] || args+=( "--host-resolver-rules=MAP * ~NOTFOUND" )
  if [[ "$kind" == "dom" ]]; then
    "$bin" "${args[@]}" --dump-dom "$url" >| "$outfile" 2>/dev/null &
  else
    "$bin" "${args[@]}" "--screenshot=${outfile}" "$url" >/dev/null 2>&1 &
  fi
  pid=$!
  for i in $(seq 1 60); do
    if [[ "$kind" == "dom" ]]; then
      grep -q '</html>' "$outfile" 2>/dev/null && { ready=1; break; }
    else
      [[ -s "$outfile" ]] && { sleep 0.5; ready=1; break; }
    fi
    kill -0 "$pid" 2>/dev/null || { [[ -s "$outfile" ]] && ready=1; break; }
    sleep 0.5
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  rm -rf "$profile"
  [[ "$ready" == "1" ]]
}

do_shot() {
  local bin work png_dir probe dom marks
  bin="$(find_shot_browser)" || die 4 "--shot needs Helium, Google Chrome or Chromium; none found"
  png_dir="$(cd "$(dirname "$SHOT")" 2>/dev/null && pwd || true)"
  if [[ -z "$png_dir" ]]; then
    mkdir -p "$(dirname "$SHOT")"
    png_dir="$(cd "$(dirname "$SHOT")" && pwd)"
  fi
  SHOT="${png_dir}/$(basename "$SHOT")"
  work="$(mktemp -d "${TMPDIR:-/tmp}/spacedown-shot.XXXXXX")"

  rm -f "$SHOT"
  run_shot_browser "$bin" png "$SHOT" "file://${OUT}" || { rm -f "$SHOT"; die 4 "--shot: no screenshot written by $(basename "$bin")"; }

  # Wide-table check: a measuring copy of the page (the real output stays untouched) records
  # every table wider than its container in a body attribute, read back with --dump-dom.
  probe="${work}/probe.html"
  { cat "$OUT"; cat <<'PROBE'
<script>
window.addEventListener("load", function () {
  var marks = [], culprits = [];
  Array.prototype.forEach.call(document.querySelectorAll("table"), function (t, i) {
    var box = t.parentElement;
    var w = Math.max(t.scrollWidth, Math.round(t.getBoundingClientRect().width));
    var c = box.clientWidth;
    if (c > 0 && (w > c + 1 || t.scrollWidth > t.clientWidth + 1)) {
      marks.push((i + 1) + ":" + w + "/" + c);
      // Culprit: the body cell with the widest min-content (its longest unbreakable run, e.g. an
      // inline code span or a URL), because that sets the column floor. Measured on an off-screen
      // one-cell table, so cell-scoped rules such as "td code { white-space: nowrap }" apply.
      var best = null, bestMin = -1, ruler = document.createElement("table");
      ruler.style.cssText = "position:absolute;visibility:hidden;width:min-content";
      document.body.appendChild(ruler);
      Array.prototype.forEach.call(t.querySelectorAll("tbody tr"), function (tr, r) {
        Array.prototype.forEach.call(tr.cells, function (td, k) {
          var probe = td.cloneNode(true);
          probe.style.minWidth = "0"; // measure the content, not the layout floor
          ruler.innerHTML = "<tbody><tr></tr></tbody>";
          ruler.rows[0].appendChild(probe);
          var mc = ruler.getBoundingClientRect().width;
          if (mc > bestMin) {
            var code = probe.querySelector("code");
            best = { r: r + 1, k: k + 1, td: td, code: !!code && code.getBoundingClientRect().width >= probe.getBoundingClientRect().width - 20 };
            bestMin = mc;
          }
        });
      });
      document.body.removeChild(ruler);
      if (best) culprits.push((i + 1) + ":" + best.r + ":" + best.k + ":" + (best.code ? "code" : "text") + ":" + (best.td.textContent || "").replace(/[\s&<>"]+/g, " ").trim().slice(0, 40));
    }
  });
  document.body.setAttribute("data-sd-wide", marks.join(" "));
  document.body.setAttribute("data-sd-widecell", culprits.join("\t"));
  // KaTeX draws a parse error (.katex-error) and an unknown macro (red mathcolor) in red.
  var red = document.querySelectorAll('.katex mstyle[mathcolor="#cc0000"], .katex-error');
  var seen = [];
  Array.prototype.forEach.call(red, function (e) {
    var t = (e.textContent || "").replace(/\s+/g, " ").trim().slice(0, 40);
    if (t && seen.indexOf(t) < 0 && seen.length < 5) seen.push(t);
  });
  document.body.setAttribute("data-sd-katex", red.length + "\t" + seen.join(" | ").replace(/"/g, "'"));
});
</script>
PROBE
  } >| "$probe"
  dom="${work}/dom.html"
  if run_shot_browser "$bin" dom "$dom" "file://${probe}"; then
    marks="$(grep -o 'data-sd-wide="[^"]*"' "$dom" | head -1 | sed 's/^data-sd-wide="//; s/"$//')"
    local m dims cells cell detail
    cells="$(grep -o 'data-sd-widecell="[^"]*"' "$dom" | head -1 | sed 's/^data-sd-widecell="//; s/"$//')"
    for m in $marks; do
      dims="${m#*:}"
      detail=""
      while IFS= read -r cell; do
        [[ "${cell%%:*}" == "${m%%:*}" ]] || continue
        cell="${cell#*:}"
        local row col kind text
        IFS=: read -r row col kind text <<<"$cell"
        detail="; widest unbreakable cell row ${row} col ${col}: \"${text}\""
        [[ "$kind" == "code" ]] && detail+=" (inline code)"
      done < <(tr '\t' '\n' <<<"$cells")
      log "WARN wide table #${m%%:*}: ${dims%%/*} px wide in a ${dims##*/} px container (scrolls sideways at ${SHOT_W}px)${detail}"
    done
    local kx
    kx="$(grep -o 'data-sd-katex="[^"]*"' "$dom" | head -1 | sed 's/^data-sd-katex="//; s/"$//')"
    if [[ -n "$kx" && "${kx%%$'\t'*}" != "0" ]]; then
      log "WARN katex: ${kx%%$'\t'*} formula part(s) render in red (an unknown macro or a parse error): ${kx#*$'\t'}"
    fi
  else
    log "wide-table and katex checks skipped (no DOM from the browser within 30s)"
  fi
  rm -rf "$work"
  echo "$SHOT"
}

# ---- single render ----
if ! do_render; then
  die 2 "render failed (see stderr above)"
fi

# Emit absolute path on stdout (the contract).
echo "$OUT"

[[ -z "$SHOT" ]] || do_shot

# ---- live-reload server (watch mode) ----
# Serve $OUT at / and its mtime at /__sd_version on localhost:<ephemeral>. The injected poll
# script reloads the page when the mtime changes (entr re-renders $OUT on each save). The server
# is reaped on exit alongside its port file. If it fails to start, fall back to manual refresh.
SERVE_URL=""
if [[ "$LIVERELOAD" == "1" && "$WATCH" == "1" ]]; then
  LR_PORT_FILE="$(mktemp -t spacedown-lrport 2>/dev/null || true)"
  if [[ -n "${LR_PORT_FILE:-}" ]]; then
    python3 "$LIVERELOAD_SERVER" "$OUT" "$LR_PORT_FILE" &
    LR_PID=$!
    trap 'kill "${LR_PID:-0}" 2>/dev/null; rm -f "$LR_PORT_FILE"' EXIT
    for _i in $(seq 1 60); do [[ -s "$LR_PORT_FILE" ]] && break; sleep 0.05; done
    LR_PORT="$(cat "$LR_PORT_FILE" 2>/dev/null || true)"
    if [[ -n "$LR_PORT" ]]; then
      SERVE_URL="http://127.0.0.1:${LR_PORT}/"
      log "live-reload on ${SERVE_URL} (edits auto-refresh the page; Ctrl-C to stop)"
    else
      log "live-reload server did not start; falling back to manual refresh"
      LIVERELOAD=0
      kill "${LR_PID:-0}" 2>/dev/null || true
    fi
  fi
fi

# ---- open browser unless suppressed ----
# Prefer a Chromium-based browser: spacedown's CSS targets VS Code's Chromium rendering,
# and Safari (WebKit) mis-renders the JetBrains Mono variable font. Fall back to the
# system default if no Chromium browser is installed. Override the preference list with
# SPACEDOWN_BROWSER="App Name".
# In live-reload mode open the server URL (so the poll script can reach /__sd_version);
# otherwise open the file directly.
OPEN_TARGET="${SERVE_URL:-$OUT}"
if [[ "$NO_OPEN" == "0" ]]; then
  if command -v open >/dev/null 2>&1; then
    opened=0
    for app in "${SPACEDOWN_BROWSER:-}" "Helium" "Arc" "Google Chrome" "Microsoft Edge" "Brave Browser"; do
      [[ -n "$app" && -d "/Applications/${app}.app" ]] || continue
      if open -a "$app" "$OPEN_TARGET" 2>/dev/null; then log "opened in ${app}"; opened=1; break; fi
    done
    if [[ "$opened" == "0" ]]; then
      open "$OPEN_TARGET"
      log "opened in default browser (no Chromium browser found; Safari may mis-render the font)"
    fi
  else
    log "open(1) not available; skipping browser launch"
  fi
fi

# ---- watch mode ----
if [[ "$WATCH" == "1" ]]; then
  command -v entr >/dev/null 2>&1 || die 3 "--watch requires entr; brew install entr"
  log "watching ${FILE} for changes (Ctrl-C to stop)"
  # SIGINT in the entr loop bubbles up to us; trap and exit 130 cleanly.
  trap 'log "stopped"; exit 130' INT
  # Each save runs this script once more on the same file, so a re-render is a normal render
  # (same flags, same settings). -n = non-interactive (don't try to clear screen / read stdin).
  rerender=( "$FILE" --out "$OUT" --title "$TITLE" --no-open )
  rerender+=( --font-mode "$FONT_MODE" )
  [[ "$STANDALONE" == "1" ]] || rerender+=( --no-standalone )
  while true; do
    echo "$FILE" | SPACEDOWN_LIVERELOAD="$LIVERELOAD" entr -n -p bash -c '"$@" >/dev/null' _ "$SELF" "${rerender[@]}" || true
    # entr exits 0 when it processed an event; loop forever until Ctrl-C.
    log "change detected, re-rendered"
  done
fi

exit 0
